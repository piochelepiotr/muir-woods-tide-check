.gov/alerts/urn:oid:2.49.0.1.840.0.e12a81073013ff7d644ef3a1ea0f4eadbf08d00b.002.2","identifier":"urn:oid:2.49.0.1.840.0.e12a81073013ff7d644ef3a1ea0f4eadbf08d00b.002.2","sender":"w-nws.webmaster@noaa.gov","sent":"2026-11-19T11:55:00-08:00"},{"@id":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.4d9fcaca5d239928ede605f4f5736c6c55ee00e1.002.2","identifier":"urn:oid:2.49.0.1.840.0.4d9fcaca5d239928ede605f4f5736c6c55ee00e1.002.2","sender":"w-nws.webmaster@noaa.gov","sent":"2026-11-19T12:02:00-08:00"}],"sent":"2026-11-20T03:41:00-08:00","effective":"2026-11-20T03:41:00-08:00","onset":"2026-11-20T03:41:00-08:00","expires":"2026-11-20T11:00:00-08:00","ends":"2026-11-21T11:00:00-08:00","status":"Actual","messageType":"Update","category":"Met","severity":"Minor","certainty":"Likely","urgency":"Expected","event":"Coastal Flood Advisory","sender":"w-nws.webmaster@noaa.gov","senderName":"NWS San Francisco CA","headline":"Coastal Flood Advisory issued November 20 at 3:41AM PST until November 21 at 11:00AM PST by NWS San Francisco CA","description":"* WHAT...For the Coastal Flood Advisory, up to 1.4 ft of\ninundation above ground level is likely in low-lying areas near\nshorelines and tidal waterways.\n\n* WHERE...Bayshore locations along the San Franciso Bay and San\nPablo Bay.\n\n* WHEN...Until 11 AM PST Saturday.\n\n* IMPACTS...High tides will result in flooding of low-lying\ninfrastructure, isolated road closures, and coastal erosion.\nRising tides will bring water and waves farther up the beach\nthan normal, restricting escape from beaches and coastal areas.\n\n* ADDITIONAL DETAILS...At the San Francisco tidal gauge, high tide\nis expected to be 1.1 ft above normal (6.9 ft MLLW) at 7:45 AM\ntoday and 1.4 ft above normal (7.2 ft MLLW) at 8:15 AM\nSaturday. These predictions include up to 1.8 ft of surge that\nwill enhance the astronomical tide and flooding threat. High\ntide varies up to 90 minutes earlier or later along the Pacific\nCoast and through the San Francisco Bay, respectively. The\nPacific Coast will likely be added to the Advisory as early as\nSunday with the San Francisco and San Pablo Bays upgraded to a\nCoastal Flood Warning as we approach \"King Tides\".","instruction":"If travel is required, allow extra time as some roads may be\nclosed. Do not drive around barricades or through water of\nunknown depth. Take the necessary actions to protect flood-prone\nproperty.","response":"Monitor","note":null,"parameters":{"AWIPSidentifier":["CFWMTR"],"WMOidentifier":["WHUS46 KMTR 201141"],"NWSheadline":["COASTAL FLOOD ADVISORY REMAINS IN EFFECT UNTIL 11 AM PST SATURDAY"],"BLOCKCHANNEL":["EAS","NWEM","CMAS"],"VTEC":["/O.CON.KMTR.CF.Y.0018.000000T0000Z-261121T1900Z/"],"eventEndingTime":["2026-11-21T11:00:00-08:00"],"expiredReferences":["w-nws.webmaster@noaa.gov,urn:oid:2.49.0.1.840.0.8edeba57cfbfabc987afd7865a68ffb5055bc08e.002.1,2026-11-19T05:55:00-08:00"]},"scope":"Public","code":"IPAWSv1.0","language":"en-US","web":"http://www.weather.gov","eventCode":{"SAME":["NWS"],"NationalWeatherService":["CFY"]}}}],"title":"Current watches, warnings, and advisories","updated":"2026-11-20T16:05:07+00:00"}}},"note":"No report does not mean open. Disappearance of a report does not establish reopening.","latestGaugeObservation":{"t":"2026-11-20 16:00","v":"6.848","s":"0.259","f":"1,0,0,0","q":"p"},"gaugeObservations":[{"t":"2026-11-20 13:06","v":"5.3","s":"0.269","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:12","v":"5.408","s":"0.256","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:18","v":"5.503","s":"0.249","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:24","v":"5.628","s":"0.276","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:30","v":"5.746","s":"0.246","f":"0,0,0,0","q":"p"},{"t":"2026-11-20 13:36","v":"5.851","s":"0.272","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:42","v":"5.897","s":"0.243","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:48","v":"5.986","s":"0.256","f":"1,0,0,0","q":"p"},{"t":"2026-11-20 13:54","v":"6.054","s":"0.285","f":"0,0,0,0","q":"p"